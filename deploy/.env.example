# Скопируйте этот файл рядом и назовите просто .env
# (то есть должно получиться deploy/.env)
#
# Этот файл-образец лежит в репозитории, а сам .env — нет:
# он в .gitignore, пароли на GitHub не уезжают.

# Адрес FTP-сервера. Смотрится в панели Majordomo.
FTP_HOST=ftp.majordomo.ru

# FTP-пользователь и его пароль
FTP_USER=f000000_имя
FTP_PASS=пароль

# Папка сайта на сервере — берётся из панели, у карточки домена.
# Обычно что-то вроде /ashpartners.ru/www или /home/.../www
FTP_DIR=/ashpartners.ru/www
